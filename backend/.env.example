# Optional: concerts & shows on the Events tab (https://developer.ticketmaster.com/)
TICKETMASTER_API_KEY=
# Optional: PA General Assembly bills on the Politics tab (https://open.pluralpolicy.com/accounts/profile/)
OPENSTATES_API_KEY=

# Demo mode: skip the network and serve sample data for everything (flagged as sample in responses).
PULSE_OFFLINE=0
# Background refresh jobs (live scores every minute, weather every 30 minutes, ...).
PULSE_SCHEDULER=1
# Comma-separated allowed origins for the web build, or * for any.
PULSE_CORS_ORIGINS=*
# Override the news feeds: "Name|url,Name|url"
# NEWS_FEEDS=
